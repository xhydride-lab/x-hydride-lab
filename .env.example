# ===========================================================================
# X-Hydride Lab — environment configuration
# Copy this file to .env.local and fill in the values you need.
# ===========================================================================

# --- xAI Grok provider (default AI provider) ----------------------------------
# Without an API key the app runs in demo mode with high-quality mock data.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# --- Supabase (optional; the app runs without it in demo mode) ----------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Audit settings -----------------------------------------------------------
# Salt mixed into the audit input/output hashes. Optional but recommended.
AUDIT_HASH_SALT=

# --- Solana on-chain anchoring (optional) -------------------------------------
# When SOLANA_PAYER_SECRET_KEY is set, /api/create-audit-log will additionally
# anchor a SHA-256 audit hash to Solana via a Memo program transaction. The
# resulting transaction signature is stored on the AuditLog record and surfaced
# in the UI as a Solscan link.
#
# SOLANA_PAYER_SECRET_KEY accepts either:
#   - a base58 string of the 64-byte secret key, or
#   - a JSON array of 64 numbers (as produced by `solana-keygen new --outfile`).
#
# The payer needs a small amount of SOL on the target network (~0.005 SOL is
# plenty for hundreds of memo transactions on mainnet-beta).
SOLANA_PAYER_SECRET_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# --- Daily Drop cron (optional) -----------------------------------------------
# Shared secret required by /api/cron/daily-drop. Vercel sends this header
# automatically when the cron is configured in vercel.json. Set it to a random
# string and add the same value as `CRON_SECRET` in the Vercel dashboard.
CRON_SECRET=
